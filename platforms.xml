<freInclude xmlns:xi="http://www.w3.org/2003/XInclude">

    <platform name="gfdl.postprocess">
      <freVersion>$(FRE_VERSION)</freVersion>
      <property name="NB_ROOT"            value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
      <property name="F2003_FLAGS"        value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/archive"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/archive"/>
      <property name="CMIP6_ARCHIVE_ROOT" value="/archive/oar.gfdl.cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/archive"/>

      <directory stem="$(FRE_STEM)" >
        <root>/home/$USER/SPEAR</root>
        <archive>/archive/$USER/SPEAR/$(name)</archive>
        <include>$(rootDir)/SPEAR_include</include> 
        <analysis>/nbhome/$USER/$(stem)/$(name)</analysis>
      </directory>

      <csh><![CDATA[
        module load git
        setenv NBROOT $(NB_ROOT)
        setenv FREVERSION fre/$(FRE_VERSION)
        ]]>
      </csh>
    </platform>

    <platform name="gfdl.ncrc3-intel18">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="gfdl.ncrc4-intel18">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="gfdl.ncrc3-intel22">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="gfdl.ncrc4-intel22">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="gfdl.ncrc5-intel22">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="gfdl.ncrc3-gcc">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="gfdl.ncrc4-gcc">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="ncrc4.intel18">
      <freVersion>$(FRE_VERSION)</freVersion>
      <compiler type="intel" version="18.0.6.288" />

      <property name="F2003_FLAGS"      value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/lustre/f2/dev/gfdl/William.Cooke"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/lustre/f2/pdata/gfdl/gfdl_M/David.Paynter"/>
      <property name="CMIP6_ARCHIVE_ROOT"   value="$PDATA/gfdl/cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/lustre/f2/dev/gfdl/William.Cooke/pdata/gfdl_SD"/>
      <property name="NB_ROOT"          value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
 
      <project>$(GFDL_YGL)</project>

      <directory stem="$(FRE_STEM)">
        <include>$(xmlDir)/SPEAR_include</include>
      </directory>
    </platform>

    <platform name="ncrc3.intel18">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='ncrc4.intel18']/node())" />
    </platform>

    <platform name="ncrc4.gcc">
      <freVersion>$(FRE_VERSION)</freVersion>
      <compiler type="gcc" version="9.3.0" />

      <property name="F2003_FLAGS"      value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/lustre/f2/dev/gfdl/William.Cooke"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/lustre/f2/pdata/gfdl/gfdl_M/David.Paynter"/>
      <property name="CMIP6_ARCHIVE_ROOT"   value="$PDATA/gfdl/cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/lustre/f2/dev/gfdl/William.Cooke/pdata/gfdl_SD"/>
      <property name="NB_ROOT"          value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
 
      <project>$(GFDL_YGL)</project>

      <directory stem="$(FRE_STEM)">
        <include>$(xmlDir)/SPEAR_include</include>
      </directory>
    </platform>

    <platform name="ncrc3.gcc">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='ncrc4.gcc']/node())" />
    </platform>

    <platform name="ncrc4.intel22">
      <freVersion>$(FRE_VERSION)</freVersion>
      <compiler type="intel" version="intel-classic-2022.0.2" />

      <property name="F2003_FLAGS"      value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/lustre/f2/dev/gfdl/William.Cooke"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/lustre/f2/pdata/gfdl/gfdl_M/David.Paynter"/>
      <property name="CMIP6_ARCHIVE_ROOT"   value="$PDATA/gfdl/cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/lustre/f2/dev/gfdl/William.Cooke/pdata/gfdl_SD"/>
      <property name="NB_ROOT"          value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
 
      <project>$(GFDL_YGL)</project>

      <directory stem="$(FRE_STEM)">
        <include>$(xmlDir)/SPEAR_include</include>
      </directory>

      <csh><![CDATA[
       module swap craype craype/2.7.7
       module swap PrgEnv-intel PrgEnv-intel/6.0.10
       module swap intel intel/intel-classic-2021.3.0
      ]]></csh>
    </platform>

    <platform name="ncrc5.intel22">
      <freVersion>$(FRE_VERSION)</freVersion>
      <compiler type="intel-classic" version="2022.0.2" />

      <property name="F2003_FLAGS"      value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/lustre/f2/dev/gfdl/William.Cooke"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/lustre/f2/pdata/gfdl/gfdl_M/David.Paynter"/>
      <property name="CMIP6_ARCHIVE_ROOT"   value="$PDATA/gfdl/cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/lustre/f2/dev/gfdl/William.Cooke/pdata/gfdl_SD"/>
      <property name="NB_ROOT"          value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
 
      <project>$(GFDL_YGL)</project>

      <directory stem="$(FRE_STEM)">
        <include>$(xmlDir)/SPEAR_include</include>
      </directory>
     <csh><![CDATA[
       module unload cray-libsci
      ]]></csh>

    </platform>

    <platform name="ncrc3.intel22">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='ncrc4.intel22']/node())" />
    </platform>

</freInclude>
