<freInclude xmlns:xi="http://www.w3.org/2003/XInclude">

    <platform name="gfdl.postprocess">
      <freVersion>$(FRE_VERSION)</freVersion>
      <property name="NB_ROOT"            value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
      <property name="F2003_FLAGS"        value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/archive"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/archive"/>
      <property name="CMIP6_ARCHIVE_ROOT" value="/archive/oar.gfdl.cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/archive"/>

      <directory stem="$(FRE_STEM)" >
        <root>/home/$USER/SPEAR</root>
        <archive>/archive/$USER/SPEAR/$(name)</archive>
        <include>$(rootDir)/SPEAR_include</include> 
        <analysis>/nbhome/$USER/$(stem)/$(name)</analysis>
      </directory>

      <csh><![CDATA[
        module load git
        setenv NBROOT $(NB_ROOT)
        setenv FREVERSION fre/$(FRE_VERSION)
        ]]>
      </csh>
    </platform>

    <platform name="gfdl.ncrc5-intel23-classic">
      <xi:include xpointer="xpointer(//freInclude/platform[@name='gfdl.postprocess']/node())" />
    </platform>

    <platform name="ncrc5.intel23-classic">
      <freVersion>$(FRE_VERSION)</freVersion>
      <compiler type="intel-classic" version="2023.1.0" />

      <property name="F2003_FLAGS"      value="-DINTERNAL_FILE_NML"/>
      <property name="WFC_ARCHIVE_ROOT"  value="/gpfs/f5/gfdl_sd/world-shared/William.Cooke"/>
      <property name="DJP_ARCHIVE_ROOT"  value="/gpfs/f5/gfdl_m/world-shared/David.Paynter"/>
      <property name="CMIP6_ARCHIVE_ROOT"   value="/gpfs/f5/gfdl_a/world-shared/cmip6/datasets"/>
      <property name="SD_ARCHIVE_ROOT"   value="/gpfs/f5/gfdl_sd/world-shared"/>
      <property name="NB_ROOT"          value="/nbhome/$USER/$(FRE_STEM)$(DEBUGLEVEL)/$(name)"/>
 
      <project>$(GFDL_YGL)</project>

      <directory stem="$(FRE_STEM)">
        <include>$(xmlDir)/SPEAR_include</include>
      </directory>
    </platform>
</freInclude>
