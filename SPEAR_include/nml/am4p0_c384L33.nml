        a2b_ord  = 4,
        adjust_dry_mass =  $adjust_dry_mass
        adj_mass_vmr    = .true.,
        print_freq = 0,
        grid_type = 0,
        tau = 0.      
        do_uni_zfull = .false.
       n_sponge = 0
       d2_bg_k1 = 0.15
       d2_bg_k2 = 0.02
       beta   = 0
       d_ext = 0.
       d2_bg = 0.
       nord =  3
       dddmp = 0.2
       d4_bg = 0.15
       vtdm4 = 0.03
       delt_max = 0.002
       ke_bg    = 0.
       do_vort_damp = .T.
       d_con = 1
       hord_mt = 5
       hord_vt = 5
       hord_tm = 5
       hord_dp = -5
       hord_tr = 8
       kord_tm = -9
       kord_mt =  9
       kord_wz =  9
       kord_tr =  9
       consv_te = 0.7
       fill = .T.
       z_tracer = .T.
       nwat     = 6
       make_nh  = .F. ! for restart run
       hydrostatic  = .F.
       use_hydro_pressure = .F.
       phys_hydrostatic   = .F.
       fv_debug   = .F.
       range_warn = .F. 
       reset_eta  = .F.
       rf_fast    = .F.
       rf_cutoff  = 7.5e2
       a_imp      = 1.
       p_fac      = 0.1
       na_init     = 0
       fv_sg_adj  = 600
       mountain   = .T. 
       do_sat_adj = .T.
       consv_am   = .T.
       dwind_2d = .F.
/

 &mg_drag_nml
        gmax  = 1.0,
        acoef = 1.,
        do_conserve_energy = .true.,
        source_of_sgsmtn = 'input/computed'
/

 &topo_drag_nml
        frcrit  = 0.7
        alin    = 0.9
        anonlin = 3.0
        use_mg_scaling = .true.
        do_pbl_average = .false.
        use_mask_for_pbl = .false.
