        gamma = 0.4
        epsi = 0.0
        h_frac = 0.1
        zref_fac = 1.0
        no_drag_frac = 0.1
        tboost = 1.5
        pcut = 0.
        samp = 2.
        do_conserve_energy = .true.
        use_pbl_from_lock = .true.
        use_uref_4stable = .true.
/


 &cg_drag_nml
        cg_drag_freq = 600,
        cg_drag_offset = 0,
        Bt_0 =  0.005,
        Bt_aug= 0.000,
        Bt_nh=  0.002,
        Bt_sh= -0.00025,
        Bt_eq=  0.000,
